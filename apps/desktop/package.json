{
  "name": "@interviewharness/desktop",
  "productName": "InterviewHarness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test:e2e": "electron-vite build && playwright test",
    "test": "vitest run --dir src",
    "scripted-rounds": "node scripts/scripted-rounds.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@interviewharness/core": "workspace:*",
    "@interviewharness/engine": "workspace:*",
    "@interviewharness/providers": "workspace:*",
    "lucide-react": "1.64.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-vite": "6.0.0",
    "marked": "18.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
